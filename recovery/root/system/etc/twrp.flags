# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

# mount_point  fstype   device            device2                      flags
/cache          ext4    /dev/block/bootdevice/by-name/cache            flags=display="Cache";backup=0;wipeingui
/boot           emmc    /dev/block/bootdevice/by-name/boot             flags=display="Boot";backup=1;flashimg
/recovery       emmc    /dev/block/bootdevice/by-name/recovery         flags=display="Recovery";backup=1;flashimg
/metadata       ext4    /dev/block/bootdevice/by-name/metadata         flags=display="Metadata";wrappedkey
/data           f2fs    /dev/block/bootdevice/by-name/userdata         flags=display="Data";fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized+wrappedkey_v0,metadata_encryption=aes-256-xts:wrappedkey_v0,keydirectory=/metadata/vold/metadata_encryption
/persist        ext4    /dev/block/bootdevice/by-name/persist          flags=display="Persist";backup=0
/persist_image  emmc    /dev/block/bootdevice/by-name/persist          flags=display="Persist-Image";backup=1;flashimg

# Removable storage
/usb_otg        auto    /dev/block/sdg1       /dev/block/sdg           flags=display="USB-Storage";storage;wipeingui;removable;fsflags="utf8"

# firmware
/abl                emmc    /dev/block/bootdevice/by-name/abl              flags=display="ABL";backup=1;flashimg
/dtbo               emmc    /dev/block/bootdevice/by-name/dtbo             flags=display="DTBO";backup=1;flashimg
/vbmeta             emmc    /dev/block/bootdevice/by-name/vbmeta           flags=display="Vbmeta";backup=1;flashimg
/vbmeta_system      emmc    /dev/block/bootdevice/by-name/vbmeta_system    flags=display="Vbmeta_System";backup=1;flashimg
/imagefv            emmc    /dev/block/bootdevice/by-name/imagefv          flags=display="Imagefv";backup=1;flashimg
/xbl_config         emmc    /dev/block/bootdevice/by-name/xbl_config       flags=display="XBL_Config";backup=1;flashimg
/cmnlib             emmc    /dev/block/bootdevice/by-name/cmnlib           flags=display="Cmnlib";backup=1;flashimg
/dsp                emmc    /dev/block/bootdevice/by-name/dsp              flags=display="DSP";backup=1;flashimg
/hyp                emmc    /dev/block/bootdevice/by-name/hyp              flags=display="HYP";backup=1;flashimg
/keymaster          emmc    /dev/block/bootdevice/by-name/keymaster        flags=display="Keymaster";backup=1;flashimg
/tz                 emmc    /dev/block/bootdevice/by-name/tz               flags=display="TZ";backup=1;flashimg
/engineering_cdt    emmc    /dev/block/bootdevice/by-name/engineering_cdt  flags=display="Engineering_Cdt";backup=1;flashimg
/splash             emmc    /dev/block/bootdevice/by-name/splash           flags=display="Splash";backup=1;flashimg
/bluetooth          emmc    /dev/block/bootdevice/by-name/bluetooth        flags=display="Bluetooth";backup=1;flashimg
/qupfw              emmc    /dev/block/bootdevice/by-name/qupfw            flags=display="QUPFW";backup=1;flashimg
/oppostanvbk        emmc    /dev/block/bootdevice/by-name/oppostanvbk      flags=display="Oppostanvbk";backup=1;flashimg
/DRIVER             emmc    /dev/block/bootdevice/by-name/DRIVER           flags=display="DRIVER";backup=1;flashimg
/cmnlib64           emmc    /dev/block/bootdevice/by-name/cmnlib64         flags=display="Cmnlib64";backup=1;flashimg 
/vbmeta_vendor      emmc    /dev/block/bootdevice/by-name/vbmeta_vendor    flags=display="Vbmeta_Vendor";backup=1;flashimg
/devcfg             emmc    /dev/block/bootdevice/by-name/devcfg           flags=display="Devcfg";backup=1;flashimg
/modem              emmc    /dev/block/bootdevice/by-name/modem            flags=display="Modem";backup=1;flashimg
/oppo_sec           emmc    /dev/block/bootdevice/by-name/oppo_sec         flags=display="Oppo_Sec";backup=1;flashimg
/aop                emmc    /dev/block/bootdevice/by-name/aop              flags=display="AOP";backup=1;flashimg
/apdp               emmc    /dev/block/bootdevice/by-name/apdp             flags=display="APDP";backup=1;flashimg
/xbl                emmc    /dev/block/bootdevice/by-name/xbl              flags=display="XBL";backup=1;flashimg
